from datetime import datetime, timezone
from uuid import uuid4

from sqlalchemy import (
    Boolean,
    DateTime,
    Float,
    ForeignKey,
    Integer,
    String,
    Text,
)

from sqlalchemy.dialects.postgresql import JSONB
from sqlalchemy.orm import Mapped, mapped_column

from app.db.base import Base


def utc_now() -> datetime:
    return datetime.now(
        timezone.utc
    )


class ActionPlan(Base):
    __tablename__ = "action_plans"

    id: Mapped[int] = mapped_column(
        primary_key=True
    )

    action_uuid: Mapped[str] = mapped_column(
        String(36),
        unique=True,
        index=True,
        default=lambda: str(
            uuid4()
        ),
    )

    # -------------------------------------------------
    # SOURCE / TRACEABILITY
    # -------------------------------------------------

    rca_case_id: Mapped[int] = mapped_column(
        ForeignKey(
            "rca_cases.id",
            ondelete="CASCADE",
        ),
        nullable=False,
        index=True,
    )

    alert_id: Mapped[int | None] = mapped_column(
        ForeignKey(
            "alerts.id",
            ondelete="SET NULL",
        ),
        nullable=True,
        index=True,
    )

    device_id: Mapped[int | None] = mapped_column(
        ForeignKey(
            "devices.id",
            ondelete="SET NULL",
        ),
        nullable=True,
        index=True,
    )

    source_primary_cause: Mapped[
        str
    ] = mapped_column(
        String(120),
        index=True,
    )

    source_confidence: Mapped[
        float | None
    ] = mapped_column(
        Float,
        nullable=True,
    )

    source_verifier_status: Mapped[
        str | None
    ] = mapped_column(
        String(40),
        nullable=True,
    )

    # -------------------------------------------------
    # ACTION IDENTITY
    # -------------------------------------------------

    action_code: Mapped[str] = mapped_column(
        String(80),
        index=True,
    )

    action_type: Mapped[str] = mapped_column(
        String(50),
        index=True,
    )

    target_type: Mapped[str] = mapped_column(
        String(40),
        default="DEVICE",
        index=True,
    )

    target_ref: Mapped[
        str | None
    ] = mapped_column(
        String(120),
        nullable=True,
        index=True,
    )

    title: Mapped[str] = mapped_column(
        String(200)
    )

    description: Mapped[str] = mapped_column(
        Text
    )

    rationale: Mapped[str] = mapped_column(
        Text
    )

    # -------------------------------------------------
    # LIFECYCLE / SAFETY
    # -------------------------------------------------

    status: Mapped[str] = mapped_column(
        String(30),
        default="PROPOSED",
        index=True,
    )

    execution_mode: Mapped[str] = mapped_column(
        String(30),
        default="ADVISORY",
        index=True,
    )

    safety_gate_status: Mapped[str] = mapped_column(
        String(30),
        default="PENDING",
        index=True,
    )

    requires_human_approval: Mapped[
        bool
    ] = mapped_column(
        Boolean,
        default=True,
    )

    auto_eligible: Mapped[
        bool
    ] = mapped_column(
        Boolean,
        default=False,
    )

    risk_level: Mapped[str] = mapped_column(
        String(30),
        default="MEDIUM",
        index=True,
    )

    blast_radius: Mapped[str] = mapped_column(
        String(30),
        default="DEVICE",
        index=True,
    )

    verification_required: Mapped[
        bool
    ] = mapped_column(
        Boolean,
        default=True,
    )

    rollback_required: Mapped[
        bool
    ] = mapped_column(
        Boolean,
        default=True,
    )

    # -------------------------------------------------
    # STRUCTURED PLANS
    # -------------------------------------------------

    parameters_json: Mapped[dict] = mapped_column(
        JSONB,
        default=dict,
    )

    preconditions_json: Mapped[list] = mapped_column(
        JSONB,
        default=list,
    )

    safety_checks_json: Mapped[dict] = mapped_column(
        JSONB,
        default=dict,
    )

    verification_plan_json: Mapped[list] = mapped_column(
        JSONB,
        default=list,
    )

    rollback_plan_json: Mapped[list] = mapped_column(
        JSONB,
        default=list,
    )

    # -------------------------------------------------
    # PROVENANCE
    # -------------------------------------------------

    planner_version: Mapped[str] = mapped_column(
        String(50),
        default="ACTION_PLANNER_V1",
    )

    schema_version: Mapped[str] = mapped_column(
        String(50),
        default="ACTION_PLAN_V1",
    )

    created_at: Mapped[datetime] = mapped_column(
        DateTime(
            timezone=True
        ),
        default=utc_now,
        index=True,
    )

    updated_at: Mapped[datetime] = mapped_column(
        DateTime(
            timezone=True
        ),
        default=utc_now,
        onupdate=utc_now,
    )
